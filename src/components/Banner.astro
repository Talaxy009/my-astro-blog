---
import DarkModeButton from './DarkModeButton/index.tsx';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const { title, description } = Astro.props;
---

<div class="beer banner-root">
	<img alt="banner" class="bannerImg" src="/banner.svg" />
	<div class="banner-container">
		<h1>{title || SITE_TITLE}</h1>
		<span class="description">{description || SITE_DESCRIPTION}</span>
		{
			!title && (
				<a href="/about" class="button fill small-elevate">
					关于我
				</a>
			)
		}
	</div>
	<div class="topbar">
		<DarkModeButton client:load />
		{title && <a href="/">{SITE_TITLE}</a>}
	</div>
</div>

<style>
	.banner-root {
		border-radius: 2rem;
		position: relative;
		aspect-ratio: 1.6;
		color: #e5ffff;
	}
	.bannerImg {
		width: 100%;
	}
	.banner-container {
		justify-content: center;
		box-sizing: border-box;
		flex-direction: column;
		align-items: center;
		position: absolute;
		display: flex;
		padding: 1rem;
		height: 100%;
		width: 100%;
		top: 0;
	}
	.banner-container h1 {
		margin: 0.6em 0;
	}
	@media (max-width: 450px) {
		.banner-container h1 {
			margin: 0.4em 0;
		}
	}
	.description {
		margin-bottom: 0.8em;
		font-size: 1.2em;
	}
	.topbar {
		justify-content: space-between;
		flex-direction: row-reverse;
		box-sizing: border-box;
		align-items: center;
		position: absolute;
		padding: 1rem;
		display: flex;
		width: 100%;
		top: 0;
	}
	.topbar a {
		margin: 12px;
		color: #e5ffff;
		font-size: 1.5em;
		font-weight: bold;
	}
	a:hover {
		text-decoration: none;
	}
</style>

<style is:global>
	.dark .bannerImg {
		opacity: 0.8;
	}
</style>
