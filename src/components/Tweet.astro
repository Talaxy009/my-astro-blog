---
import TweetCard from 'astro-tweet-card';

const { id } = Astro.props;

const text = {
	replies: '回复',
	reposts: '转发',
	quotes: '引用',
	likes: '喜欢',
	replyingTo: '回复',
	viewOnX: '在 X 上查看',
	notFound: '推文不可用',
};
---

<TweetCard id={id} text={text} />

<style is:global>
	:root {
		--tc-bg: var(--surface-container-lowest);
		--tc-border: var(--outline-variant);
		--tc-text: var(--on-surface);
		--tc-text-muted: var(--on-surface-variant);
		--tc-link: var(--primary);
	}
</style>
