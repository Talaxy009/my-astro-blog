---
import Waline from 'src/components/Waline';
import Footer from 'src/components/Footer.astro';
import BaseHead from 'src/components/BaseHead.astro';
import DarkModeButton from 'src/components/DarkModeButton';
import RecommendedPost from 'src/components/RecommendedPost.astro';
import { formatTime, formatDate, toISOString } from 'src/utils/dataUtils';

import { SITE_TITLE, SITE_DESCRIPTION } from 'src/consts';

import 'src/styles/article.css';
import 'src/styles/waline.css';
import 'src/styles/code.css';

type Props = {
	post: Post;
	recommendedPosts: Post[];
};

const { post, recommendedPosts } = Astro.props;

const { id, title, description, minutesRead, img, date, tags } = post;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			image={img}
			title={title ?? SITE_TITLE}
			description={description ?? SITE_DESCRIPTION}
		/>
		<style>
			.post-cover {
				border-radius: 2rem;
				overflow: hidden;
				margin: 1em 0;
				background-color: var(--surface-container-high);
				background-image: var(--cover-ph);
				background-size: cover;
				background-position: center;
			}
			.post-cover img {
				display: block;
				width: 100%;
				height: auto;
				margin: 0;
				border-radius: 0;
				opacity: 0;
				transition: opacity 0.4s ease;
			}
			.post-cover img.loaded {
				opacity: 1;
			}
			/* 图片已加载 → 撤掉占位图，避免从部分半透明封面后面透出来 */
			.post-cover:has(img.loaded) {
				background-image: none;
			}
			@media (scripting: none) {
				.post-cover img {
					opacity: 1;
				}
			}
			.topbar {
				justify-content: space-between;
				align-items: center;
				display: flex;
				width: 100%;
			}
			.topbar a {
				margin: 12px;
				font-size: 1.5em;
				font-weight: bold;
			}
			.topbar a:hover {
				text-decoration: none;
			}
			.recommended {
				margin: 1rem 0;
			}
			.recommended h2 {
				margin-bottom: 0.8em;
			}
		</style>
	</head>
	<body>
		<main>
			<header class="beer">
				<div class="topbar">
					<a href="/">{SITE_TITLE}</a>
					<DarkModeButton client:load />
				</div>
				{img && (
					<div
						class="post-cover"
						style={`view-transition-name: post-img-${id};${
							img.placeholder
								? ` --cover-ph: url('${img.placeholder}');`
								: ''
						}`}
					>
						<img
							src={img.src}
							srcset={img.srcset}
							sizes={img.sizes}
							width={img.width}
							height={img.height}
							alt={title}
						/>
					</div>
				)}
				<h1>{title}</h1>
				<div class="row vertical-margin">
					<time datetime={toISOString(date)}>{formatDate(date)}</time>
					•<span>{formatTime(minutesRead)}</span>
				</div>
				<div class="row">
					{tags.map((tag) => (
						<button class="chip round">{tag}</button>
					))}
				</div>
			</header>
			<article>
				<slot />
			</article>
			<hr />
			{recommendedPosts.length > 0 && (
				<section class="recommended beer">
					<h2>推荐阅读</h2>
					<div class="grid">
						{recommendedPosts.map((rec) => (
							<RecommendedPost post={rec} />
						))}
					</div>
				</section>
			)}
			<Waline client:idle path={`/${id}/`} />
		</main>
		<Footer />
		<script is:inline>
			// 封面渐显：本布局没有水合，用一段内联脚本（逻辑与 PostItem 一致）。
			// 只负责加 .loaded —— 渐显和撤掉占位图都交给 CSS（含 :has()）。
			document.querySelectorAll('.post-cover img').forEach((img) => {
				const show = () => img.classList.add('loaded');
				if (img.complete) show();
				else img.addEventListener('load', show, { once: true });
			});
		</script>
	</body>
</html>
