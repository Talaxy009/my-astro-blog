---
import BaseHead from '../components/BaseHead.astro';

import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="找不到页面" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main>
			<img alt="404 image from Storyset" src="/404.svg" />
			<p>
				抱歉 😭 找不到你要的页面，该页面可能已经被删除或者更改了位置。
				<br />
				<a href="/">返回首页</a>
			</p>
		</main>
	</body>
</html>
<style>
	main {
		padding: 10vh 0 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}
	img {
		width: 100%;
		max-width: 450px;
		height: auto;
	}
	p {
		font-size: 1.1em;
		text-align: center;
	}
</style>
