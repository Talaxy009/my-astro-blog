---
import BaseHead from '../components/BaseHead.astro';

import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="找不到页面" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="beer root">
			<img alt="banner" class="background-image" src="/banner.svg" />
			<div class="container">
				<h1>404</h1>
				<span class="description">
					找不到此页面，页面可能已被删除或变更了位置。
				</span>
				<a href="/" class="button large fill small-elevate">返回首页</a>
			</div>
		</div>
	</body>
</html>
<style>
	.root {
		width: 100vw;
		height: 100vh;
		position: relative;
		color: #e5ffff;
		overflow: hidden;
	}
	.background-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
	.container {
		justify-content: center;
		box-sizing: border-box;
		flex-direction: column;
		align-items: center;
		position: absolute;
		display: flex;
		padding: 1rem;
		height: 100%;
		width: 100%;
		top: 0;
	}
	.container h1 {
		margin: 2rem 0;
		font-size: 10em;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
	}
	.description {
		margin-bottom: 0.8em;
		font-size: 1.2em;
		text-align: center;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
	}
</style>
