---
import { getCollection, render } from 'astro:content';

import BlogPost from 'src/layouts/BlogPost.astro';
import { convertBlogToPost } from 'src/utils/dataUtils';

export async function getStaticPaths() {
	const blogs = await getCollection('blogs');
	const cache = new Map<string, Post[]>();

	return Promise.all(
		blogs.map(async (post) => {
			// 获取推荐文章：与当前文章第一个 tag 相同的最新 2 篇文章
			const firstTag = post.data.tags[0];
			let recommendedPosts: Post[] = [];
			if (cache.has(firstTag)) {
				recommendedPosts = cache
					.get(firstTag)!
					.filter((p) => p.id !== post.id)
					.slice(0, 2);
			} else {
				const relatedBlogs = blogs
					.filter((p) => p.data.tags.includes(firstTag))
					.sort(
						(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
					)
					.slice(0, 3);
				const relatedPosts = await Promise.all(
					relatedBlogs.map((item) =>
						convertBlogToPost(item, 0, false),
					),
				);
				cache.set(firstTag, relatedPosts);
				recommendedPosts = relatedPosts
					.filter((p) => p.id !== post.id)
					.slice(0, 2);
			}

			return {
				params: { slug: post.id },
				props: { post, recommendedPosts },
			};
		}),
	);
}
type Props = {
	post: Blog;
	recommendedPosts: Post[];
};

const { post, recommendedPosts } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<BlogPost
	{...post}
	minutesRead={remarkPluginFrontmatter.minutesRead}
	recommendedPosts={recommendedPosts}
>
	<Content />
</BlogPost>
