---
import { getCollection, render } from 'astro:content';

import BlogPost from 'src/layouts/BlogPost.astro';
import { convertBlogToPost } from 'src/utils/postUtils';

export async function getStaticPaths() {
	const blogs = await getCollection('blogs');
	const cache = new Map<string, Post[]>();

	return Promise.all(
		blogs.map(async (blog) => {
			// 获取推荐文章：与当前文章第一个 tag 相同的最新 2 篇文章
			const firstTag = blog.data.tags[0];
			let recommendedPosts: Post[] = [];
			if (cache.has(firstTag)) {
				recommendedPosts = cache
					.get(firstTag)!
					.filter((p) => p.id !== blog.id)
					.slice(0, 2);
			} else {
				const relatedBlogs = blogs
					.filter((p) => p.data.tags.includes(firstTag))
					.sort(
						(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
					)
					.slice(0, 3);
				const relatedPosts = await Promise.all(
					relatedBlogs.map((item) => convertBlogToPost(item)),
				);
				cache.set(firstTag, relatedPosts);
				recommendedPosts = relatedPosts
					.filter((p) => p.id !== blog.id)
					.slice(0, 2);
			}

			return {
				params: { slug: blog.id },
				props: { blog, recommendedPosts },
			};
		}),
	);
}
type Props = {
	blog: Blog;
	recommendedPosts: Post[];
};

const { blog, recommendedPosts } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(blog);
const post = await convertBlogToPost(blog, remarkPluginFrontmatter, 1280);
---

<BlogPost post={post} recommendedPosts={recommendedPosts}>
	<Content />
</BlogPost>
