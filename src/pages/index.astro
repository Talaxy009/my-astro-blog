---
import { getCollection, render } from 'astro:content';

import BaseHead from 'src/components/BaseHead.astro';
import Footer from 'src/components/Footer.astro';
import Banner from 'src/components/Banner.astro';
import PostList from 'src/components/PostList';

import { SITE_TITLE, SITE_DESCRIPTION } from 'src/consts';
import { convertBlogToPost, getPostGroup } from 'src/utils/dataUtils';

const blogs = await getCollection('blogs');
const posts = await Promise.all(
	blogs
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
		.map(async (item) => {
			const {
				remarkPluginFrontmatter: { minutesRead },
			} = await render(item);
			return await convertBlogToPost(item, minutesRead);
		}),
);
const { tags, postMap } = getPostGroup(posts, 6);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main>
			<Banner />
			<PostList client:load postMap={postMap} tags={tags} />
		</main>
		<Footer />
	</body>
</html>
